#!/bin/sh
# Pre-push: run the full local gate before publishing changes: format and lint check, then the tests
# (`make check`). `QUINT_CONNECT_SKIP_CHECKS=1` bypasses it for a WIP push; `git push --no-verify` skips all hooks.

set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Git hooks inherit repo-scoped env vars that can break nested git commands.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if [ "${QUINT_CONNECT_SKIP_CHECKS:-0}" = "1" ]; then
    echo "pre-push: QUINT_CONNECT_SKIP_CHECKS=1 set; skipping checks." >&2
    exit 0
fi

echo "pre-push: running make check"
make check
