#!/bin/sh
# Pre-commit: scan the staged diff for secrets, format the staged Swift files in place and re-stage them,
# then strict-lint them with swift-format and SwiftLint. Fast gate only: no build or tests.

set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Git hooks inherit repo-scoped env vars that can break nested git commands.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed. Install: https://github.com/gitleaks/gitleaks#installing" >&2
    exit 1
fi
echo "pre-commit: scanning staged changes for secrets"
gitleaks git --pre-commit --staged --redact --verbose

files=$(git diff --cached --name-only --diff-filter=ACMR -- 'Sources/*.swift' 'Tests/*.swift')
[ -z "$files" ] && exit 0

echo "$files" | while IFS= read -r file; do
    [ -f "$file" ] || continue
    xcrun swift-format format --in-place --configuration .swift-format "$file"
    git add -- "$file"
done

# Swift source paths in this repo do not contain spaces; keep this simple and readable.
# shellcheck disable=SC2086
xcrun swift-format lint --strict --configuration .swift-format $files

if command -v swiftlint >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    swiftlint lint --quiet --strict $files
else
    echo "pre-commit: SwiftLint is not installed: brew install swiftlint" >&2
    exit 1
fi
